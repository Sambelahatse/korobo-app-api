NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Neon PostgreSQL connection string (pooled or direct as appropriate for migrations).
DATABASE_URL=
DATABASE_CA_CERT=

# Generate a long random secret (at least 32 characters) and keep it server-side only.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# One-time setup secret for creating the first KOROBO owner; remove after setup.
OWNER_BOOTSTRAP_TOKEN=

# Google OAuth credentials (create a Web application OAuth client in Google Cloud).
# Register GOOGLE_REDIRECT_URI exactly in Google Cloud's Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# SMTP is required for invitations and password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KOROBO <no-reply@korobo.mg>
FRONTEND_URL=http://localhost:5173
