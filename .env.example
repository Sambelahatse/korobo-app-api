NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback if your project still uses the anon key.
SUPABASE_ANON_KEY=
# Server-only Supabase secret key; never use in frontend/public variables.
SUPABASE_SECRET_KEY=
# Generate a random token of at least 32 characters. Remove it after the owner is created.
OWNER_BOOTSTRAP_TOKEN=

# Use the Supabase PostgreSQL connection string from the dashboard.
# Never put real credentials in this file or commit a real .env.
DATABASE_URL=
DATABASE_CA_CERT=
