NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Custom KOROBO JWT signing secret: generate at least 32 random bytes.
# Required before enabling the new authentication endpoints in production.
JWT_SECRET=
JWT_ISSUER=korobo-app-api
JWT_AUDIENCE=korobo-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set false only for local HTTP development. Production must use true.
COOKIE_SECURE=false

# Used only for PostgreSQL hosting/connection; Supabase Auth is not the token issuer.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
OWNER_BOOTSTRAP_TOKEN=

DATABASE_URL=
DATABASE_CA_CERT=
