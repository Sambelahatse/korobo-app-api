NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Generate a random secret with at least 32 characters; required for custom JWT signing.
JWT_SECRET=
JWT_ISSUER=korobo-app-api
JWT_AUDIENCE=korobo-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to false in development and true in production; override only for local testing.
COOKIE_SECURE=false

# One-time migration/setup secret, at least 32 characters. Remove after all accounts are migrated.
OWNER_BOOTSTRAP_TOKEN=

# PostgreSQL connection string. Supabase may host PostgreSQL, but Supabase Auth is not used.
DATABASE_URL=
DATABASE_CA_CERT=
